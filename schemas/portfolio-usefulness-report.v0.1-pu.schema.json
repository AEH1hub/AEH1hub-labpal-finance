{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labpal.example/schemas/portfolio-usefulness-report.v0.1-pu.schema.json",
  "title": "PU-VALIDATE-001A Portfolio Usefulness Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone",
    "scenario_id",
    "before_snapshot_id",
    "after_snapshot_id",
    "portfolio_value_change",
    "contributors",
    "largest_absolute_contributor",
    "supported_facts",
    "causal_explanation",
    "preserved_source_unknowns",
    "review_next",
    "evidence_limitations",
    "recommendations_prohibited",
    "execution_prohibited"
  ],
  "properties": {
    "milestone": {
      "const": "PU-VALIDATE-001A"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "before_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "after_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_value_change": {
      "$ref": "#/$defs/money"
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contributor"
      }
    },
    "largest_absolute_contributor": {
      "type": "string",
      "minLength": 1
    },
    "supported_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/supportedFact"
      }
    },
    "causal_explanation": {
      "$ref": "#/$defs/causalExplanation"
    },
    "preserved_source_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preservedUnknown"
      }
    },
    "review_next": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendations_prohibited": {
      "const": true
    },
    "execution_prohibited": {
      "const": true
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holding_id",
        "symbol",
        "change",
        "direction"
      ],
      "properties": {
        "holding_id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "$ref": "#/$defs/money"
        },
        "direction": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "UNCHANGED"
          ]
        }
      }
    },
    "supportedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "statement",
        "evidence_refs"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "causalExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "claim",
        "unknowns"
      ],
      "properties": {
        "state": {
          "const": "INSUFFICIENT_EVIDENCE"
        },
        "claim": {
          "type": "null"
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preservedUnknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holding_id",
        "field_name",
        "reason"
      ],
      "properties": {
        "holding_id": {
          "type": "string",
          "minLength": 1
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
